# Copy this file to ".env" and adjust. Never commit the real .env file.

NODE_ENV=development
PORT=3000

# REQUIRED in production (32+ random characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional overrides (defaults shown)
# DB_PATH=./data/bank.db
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# BCRYPT_ROUNDS=10
# AUTH_RATE_LIMIT_MAX=10
# AUTH_RATE_LIMIT_WINDOW_MINUTES=15
# WELCOME_BONUS_MINOR=100000
# --- Production (all optional in development) ---
# CORS_ORIGINS=https://app.example.com          # browsers only; the Android app needs none
# TRUST_PROXY_HOPS=1                            # reverse proxies in front of the server
# REQUIRE_HTTPS=true                            # default in production
# DOCS_ENABLED=false                            # default in production
# ACCESS_LOG=true                               # default in production
# ALLOW_SEED=false                              # default in production
# LOOKUP_RATE_LIMIT_PER_MINUTE=30